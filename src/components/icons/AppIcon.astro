---
import type { AppIconName } from "./app-icon-name";

interface Props {
  name: AppIconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className, strokeWidth = 1.7 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "arrow-right" && (
      <>
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </>
    )
  }

  {
    name === "lock" && (
      <>
        <rect x="5" y="10" width="14" height="10" rx="2"></rect>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      </>
    )
  }

  {
    name === "chart" && (
      <>
        <path d="M4 19V5"></path>
        <path d="M4 19h16"></path>
        <path d="M8 15V9"></path>
        <path d="M12 15V6"></path>
        <path d="M16 15v-4"></path>
        <path d="M8 19a8 8 0 1 0 8-8"></path>
      </>
    )
  }

  {
    name === "family" && (
      <>
        <circle cx="8" cy="8" r="3"></circle>
        <circle cx="17" cy="9" r="2.5"></circle>
        <path d="M3 20a5.5 5.5 0 0 1 11 0"></path>
        <path d="M14 20a4.5 4.5 0 0 1 7 0"></path>
      </>
    )
  }

  {
    name === "guidance" && (
      <>
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M8.5 14.5a6 6 0 1 1 7 0c-.8.7-1.5 1.7-1.5 2.5h-4c0-.8-.7-1.8-1.5-2.5Z"></path>
        <path d="M3 12h1"></path>
        <path d="M20 12h1"></path>
        <path d="m5 5 .7.7"></path>
        <path d="m18.3 5.7.7-.7"></path>
      </>
    )
  }

  {
    name === "shield" && (
      <>
        <path d="M12 3 19 6v5c0 4.5-2.8 8.5-7 10-4.2-1.5-7-5.5-7-10V6l7-3Z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </>
    )
  }
</svg>
