      "change",
      syncAssistantMobileController,
    );
    window.addEventListener("pagehide", () => {
      assistantMobileCleanup?.();
      assistantMobileCleanup = undefined;
    });
    window.addEventListener("pageshow", syncAssistantMobileController);
    syncAssistantMobileController();
  }
</script>

