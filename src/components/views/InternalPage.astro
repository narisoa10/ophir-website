---
import {
  getLocalizedInternalPageHref,
  type InternalPageKey,
} from "../../config/site-routes";
import { siteConfig } from "../../config/site";
import type { Locale } from "../../i18n/config";
import { getTranslations } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../layout/Container.astro";

interface Props {
  locale: Locale;
  pageKey: InternalPageKey;
}

const { locale, pageKey } = Astro.props;
const t = getTranslations(locale);
const page = t.pages[pageKey];

interface DocumentSection {
  key: string;
  title: string;
  includeInNavigation?: boolean;
  paragraphs?: readonly string[];
  blocks?: readonly DocumentBlock[];
  faqItems?: readonly FaqItem[];
}

type InlineContent =
  | {
      type: "text";
      text: string;
    }
  | {
      type: "strong";
      text: string;
    }
  | {
      type: "inlineCode";
      text: string;
    }
  | {
      type: "internalLink";
      text: string;
      page: InternalPageKey;
    }
  | {
      type: "emailLink";
      text: string;
      email: string;
    }
  | {
      type: "externalLink";
      text: string;
      href: string;
    };

type DocumentBlock =
  | {
      type: "subheading";
      text: string;
    }
  | {
      type: "contactCards";
      cards: readonly {
        title: string;
        blocks: readonly DocumentBlock[];
      }[];
    }
  | {
      type: "paragraph";
      text?: string;
      content?: readonly InlineContent[];
    }
  | {
      type: "list";
      items: readonly (string | readonly InlineContent[])[];
    }
  | {
      type: "table";
      headers: readonly string[];
      rows: readonly (readonly string[])[];
    }
  | {
      type: "address";
      content: readonly InlineContent[];
    }
  | {
      type: "email";
      label: string;
      email: string;
    };

interface FaqItem {
  number: number;
  question: string;
  answer: readonly DocumentBlock[];
}

interface DocumentPage {
  title: string;
  seoTitle?: string;
  description?: string;
  showDescription?: boolean;
  updatedLabel?: string;
  updated?: string;
  updatedDate?: string;
  categoryNavigationLabel?: string;
  intro?: readonly DocumentBlock[];
  sections?: readonly DocumentSection[];
}

const documentPage = page as DocumentPage;
const pageTitle =
  documentPage.seoTitle ?? `${documentPage.title} | ${siteConfig.name}`;
const pageDescription = documentPage.description ?? siteConfig.description;

function getTextLines(text: string) {
  return text.split("\n");
}

function getInlineParts(content: string | readonly InlineContent[] | undefined) {
  if (typeof content === "string") {
    return [
      {
        type: "text",
        text: content,
      },
    ] as const;
  }

  return content ?? [];
}
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
>
  <section
    class:list={[
      "internal-page",
      documentPage.sections && "internal-page--document",
    ]}
    aria-labelledby={`internal-page-${pageKey}`}
  >
    <Container class="internal-page__container">
      <div class="internal-page__content">
        <h1 id={`internal-page-${pageKey}`} class="internal-page__title">
          {documentPage.title}
        </h1>

        {
          documentPage.description && documentPage.showDescription !== false && (
            <p class="internal-page__description">
              {documentPage.description}
            </p>
          )
        }

        {
          documentPage.updatedLabel && documentPage.updated && (
            <p class="internal-page__updated">
              <span>{documentPage.updatedLabel}</span>
              {documentPage.updatedDate ? (
                <time datetime={documentPage.updatedDate}>
                  {documentPage.updated}
                </time>
              ) : (
                documentPage.updated
              )}
            </p>
          )
        }

        {
          documentPage.intro && (
            <div class="internal-page__intro">
              {documentPage.intro.map((block) => {
                if (block.type === "paragraph") {
                  return (
                    <p>
                      {getInlineParts(block.content ?? block.text).map((part) => {
                        if (part.type === "strong") {
                          return <strong>{part.text}</strong>;
                        }

                        if (part.type === "inlineCode") {
                          return <code>{part.text}</code>;
                        }

                        if (part.type === "internalLink") {
                          return (
                            <a href={getLocalizedInternalPageHref(locale, part.page)}>
                              {part.text}
                            </a>
                          );
                        }

                        if (part.type === "emailLink") {
                          return <a href={`mailto:${part.email}`}>{part.text}</a>;
                        }

                        if (part.type === "externalLink") {
                          return <a href={part.href}>{part.text}</a>;
                        }

                        return getTextLines(part.text).map((line, index) => (
                          <>
                            {index > 0 && <br />}
                            {line}
                          </>
                        ));
                      })}
                    </p>
                  );
                }

                return null;
              })}
            </div>
          )
        }

        {
          documentPage.sections && documentPage.categoryNavigationLabel && (
            <nav
              class="internal-page__section-nav"
              aria-label={documentPage.categoryNavigationLabel}
            >
              <ul>
                {documentPage.sections
                  .filter((section) => section.includeInNavigation !== false)
                  .map((section) => (
                    <li>
                      <a href={`#${pageKey}-${section.key}`}>
                        {section.title}
                      </a>
                    </li>
                  ))}
              </ul>
            </nav>
          )
        }

        {
          documentPage.sections && (
            <article class="internal-page__document">
              {documentPage.sections.map((section) => (
                <section
                  id={`${pageKey}-${section.key}`}
                  class="internal-page__section"
                >
                  <h2>{section.title}</h2>

                  {section.paragraphs?.map((paragraph) => (
                    <p>
                      {getTextLines(paragraph).map((line, index) => (
                        <>
                          {index > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </p>
                  ))}

                  {section.blocks?.map((block) => {
                    if (block.type === "subheading") {
                      return <h3>{block.text}</h3>;
                    }

                    if (block.type === "contactCards") {
                      return (
                        <div class="internal-page__contact-cards">
                          {block.cards.map((card) => (
                            <article class="internal-page__contact-card">
                              <h3>{card.title}</h3>

                              {card.blocks.map((cardBlock) => {
                                if (cardBlock.type === "paragraph") {
                                  return (
                                    <p>
                                      {getInlineParts(cardBlock.content ?? cardBlock.text).map((part) => {
                                        if (part.type === "strong") {
                                          return <strong>{part.text}</strong>;
                                        }

                                        if (part.type === "inlineCode") {
                                          return <code>{part.text}</code>;
                                        }

                                        if (part.type === "internalLink") {
                                          return (
                                            <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                              {part.text}
                                            </a>
                                          );
                                        }

                                        if (part.type === "emailLink") {
                                          return <a href={`mailto:${part.email}`}>{part.text}</a>;
                                        }

                                        if (part.type === "externalLink") {
                                          return <a href={part.href}>{part.text}</a>;
                                        }

                                        return getTextLines(part.text).map((line, index) => (
                                          <>
                                            {index > 0 && <br />}
                                            {line}
                                          </>
                                        ));
                                      })}
                                    </p>
                                  );
                                }

                                if (cardBlock.type === "list") {
                                  return (
                                    <ul class="internal-page__list">
                                      {cardBlock.items.map((item) => (
                                        <li>
                                          {getInlineParts(item).map((part) => {
                                            if (part.type === "strong") {
                                              return <strong>{part.text}</strong>;
                                            }

                                            if (part.type === "inlineCode") {
                                              return <code>{part.text}</code>;
                                            }

                                            if (part.type === "internalLink") {
                                              return (
                                                <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                                  {part.text}
                                                </a>
                                              );
                                            }

                                            if (part.type === "emailLink") {
                                              return <a href={`mailto:${part.email}`}>{part.text}</a>;
                                            }

                                            if (part.type === "externalLink") {
                                              return <a href={part.href}>{part.text}</a>;
                                            }

                                            return getTextLines(part.text).map((line, index) => (
                                              <>
                                                {index > 0 && <br />}
                                                {line}
                                              </>
                                            ));
                                          })}
                                        </li>
                                      ))}
                                    </ul>
                                  );
                                }

                                return null;
                              })}
                            </article>
                          ))}
                        </div>
                      );
                    }

                    if (block.type === "paragraph") {
                      return (
                        <p>
                          {getInlineParts(block.content ?? block.text).map((part) => {
                            if (part.type === "strong") {
                              return <strong>{part.text}</strong>;
                            }

                            if (part.type === "inlineCode") {
                              return <code>{part.text}</code>;
                            }

                            if (part.type === "internalLink") {
                              return (
                                <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                  {part.text}
                                </a>
                              );
                            }

                            if (part.type === "emailLink") {
                              return <a href={`mailto:${part.email}`}>{part.text}</a>;
                            }

                            if (part.type === "externalLink") {
                              return <a href={part.href}>{part.text}</a>;
                            }

                            return getTextLines(part.text).map((line, index) => (
                              <>
                                {index > 0 && <br />}
                                {line}
                              </>
                            ));
                          })}
                        </p>
                      );
                    }

                    if (block.type === "list") {
                      return (
                        <ul class="internal-page__list">
                          {block.items.map((item) => (
                            <li>
                              {getInlineParts(item).map((part) => {
                                if (part.type === "strong") {
                                  return <strong>{part.text}</strong>;
                                }

                                if (part.type === "inlineCode") {
                                  return <code>{part.text}</code>;
                                }

                                if (part.type === "internalLink") {
                                  return (
                                    <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                      {part.text}
                                    </a>
                                  );
                                }

                                if (part.type === "emailLink") {
                                  return <a href={`mailto:${part.email}`}>{part.text}</a>;
                                }

                                if (part.type === "externalLink") {
                                  return <a href={part.href}>{part.text}</a>;
                                }

                                return getTextLines(part.text).map((line, index) => (
                                  <>
                                    {index > 0 && <br />}
                                    {line}
                                  </>
                                ));
                              })}
                            </li>
                          ))}
                        </ul>
                      );
                    }

                    if (block.type === "table") {
                      return (
                        <div class="internal-page__table-scroll">
                          <table class="internal-page__table">
                            <thead>
                              <tr>
                                {block.headers.map((header) => (
                                  <th scope="col">{header}</th>
                                ))}
                              </tr>
                            </thead>

                            <tbody>
                              {block.rows.map((row) => (
                                <tr>
                                  {row.map((cell) => (
                                    <td>{cell}</td>
                                  ))}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      );
                    }

                    if (block.type === "address") {
                      return (
                        <address class="internal-page__address">
                          {getInlineParts(block.content).map((part) => {
                            if (part.type === "strong") {
                              return <strong>{part.text}</strong>;
                            }

                            if (part.type === "inlineCode") {
                              return <code>{part.text}</code>;
                            }

                            if (part.type === "internalLink") {
                              return (
                                <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                  {part.text}
                                </a>
                              );
                            }

                            if (part.type === "emailLink") {
                              return <a href={`mailto:${part.email}`}>{part.text}</a>;
                            }

                            if (part.type === "externalLink") {
                              return <a href={part.href}>{part.text}</a>;
                            }

                            return getTextLines(part.text).map((line, index) => (
                              <>
                                {index > 0 && <br />}
                                {line}
                              </>
                            ));
                          })}
                        </address>
                      );
                    }

                    return (
                      <p>
                        {block.label}{" "}
                        <a href={`mailto:${block.email}`}>{block.email}</a>
                      </p>
                    );
                  })}

                  {section.faqItems && (
                    <div class="internal-page__faq-list">
                      {section.faqItems.map((faqItem) => (
                        <details class="internal-page__faq-item">
                          <summary>
                            <span class="internal-page__faq-number">
                              {faqItem.number}
                            </span>
                            <span class="internal-page__faq-question">
                              {faqItem.question}
                            </span>
                          </summary>

                          <div class="internal-page__faq-answer">
                            {faqItem.answer.map((answerBlock) => {
                              if (answerBlock.type === "paragraph") {
                                return (
                                  <p>
                                    {getInlineParts(answerBlock.content ?? answerBlock.text).map((part) => {
                                      if (part.type === "strong") {
                                        return <strong>{part.text}</strong>;
                                      }

                                      if (part.type === "inlineCode") {
                                        return <code>{part.text}</code>;
                                      }

                                      if (part.type === "internalLink") {
                                        return (
                                          <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                            {part.text}
                                          </a>
                                        );
                                      }

                                      if (part.type === "emailLink") {
                                        return <a href={`mailto:${part.email}`}>{part.text}</a>;
                                      }

                                      if (part.type === "externalLink") {
                                        return <a href={part.href}>{part.text}</a>;
                                      }

                                      return getTextLines(part.text).map((line, index) => (
                                        <>
                                          {index > 0 && <br />}
                                          {line}
                                        </>
                                      ));
                                    })}
                                  </p>
                                );
                              }

                              if (answerBlock.type === "list") {
                                return (
                                  <ul class="internal-page__list">
                                    {answerBlock.items.map((item) => (
                                      <li>
                                        {getInlineParts(item).map((part) => {
                                          if (part.type === "strong") {
                                            return <strong>{part.text}</strong>;
                                          }

                                          if (part.type === "inlineCode") {
                                            return <code>{part.text}</code>;
                                          }

                                          if (part.type === "internalLink") {
                                            return (
                                              <a href={getLocalizedInternalPageHref(locale, part.page)}>
                                                {part.text}
                                              </a>
                                            );
                                          }

                                          if (part.type === "emailLink") {
                                            return <a href={`mailto:${part.email}`}>{part.text}</a>;
                                          }

                                          if (part.type === "externalLink") {
                                            return <a href={part.href}>{part.text}</a>;
                                          }

                                          return getTextLines(part.text).map((line, index) => (
                                            <>
                                              {index > 0 && <br />}
                                              {line}
                                            </>
                                          ));
                                        })}
                                      </li>
                                    ))}
                                  </ul>
                                );
                              }

                              return null;
                            })}
                          </div>
                        </details>
                      ))}
                    </div>
                  )}
                </section>
              ))}
            </article>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
