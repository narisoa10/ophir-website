---
import type { Locale } from "../../i18n/config";

import AssistantPhoneContent from "./AssistantPhoneContent.astro";
import AssistantPlanDeviationPhone from "./AssistantPlanDeviationPhone.astro";
import AssistantPlanOutcomePhone from "./AssistantPlanOutcomePhone.astro";
import AssistantRecommendedActionsPhone from "./AssistantRecommendedActionsPhone.astro";
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";

type TextParams<T extends Record<string, string>> = (params: T) => string;

interface AssistantMockupContent {
  backLabel: string;
  infoLabel: string;
  chartLabel: string;
  step: string;
  title: string;
  todayLabel: TextParams<{ date: string }>;
  periodLabel: TextParams<{ currentDay: string; totalDays: string }>;
  incomeTitle: string;
  expenseTitle: string;
  planLabel: string;
  actualLabel: string;
  planToDateLabel: string;
  expensePlanProgressTitle: string;
  monthlyPlanLabel: string;
  monthEndForecastTitle: string;
  expensePlanLabel: string;
  expenseForecastLabel: string;
  projectedShortfallLabel: string;
  unchangedCaption: string;
  alertTitle: string;
  alertDescription: TextParams<{ shortfall: string }>;
}

interface AssistantShowcaseTranslation {
  title: string;
  subtitles: {
    diagnosis: string;
    planDeviation: string;
    recommendedActions: string;
    planOutcome: string;
  };
  indicatorGroupLabel: string;
  descriptions: {
    diagnosis: string;
    planDeviation: string;
    recommendedActions: string;
    planOutcome: string;
  };
  indicatorLabels: {
    diagnosis: string;
    planDeviation: string;
    recommendedActions: string;
    planOutcome: string;
  };
}

interface Props {
  locale: Locale;
  content: AssistantMockupContent;
  showcase: AssistantShowcaseTranslation;
  planDeviationContent: Record<string, unknown>;
  recommendedActionsContent: Record<string, unknown>;
  planOutcomeContent: Record<string, unknown>;
}

const {
  locale,
  content,
  showcase,
  planDeviationContent,
  recommendedActionsContent,
  planOutcomeContent,
} = Astro.props;

const mobileStageCopy = [
  {
    title: showcase.subtitles.diagnosis,
    description: showcase.descriptions.diagnosis,
    indicatorLabel: showcase.indicatorLabels.diagnosis,
  },
  {
    title: showcase.subtitles.planDeviation,
    description: showcase.descriptions.planDeviation,
    indicatorLabel: showcase.indicatorLabels.planDeviation,
  },
  {
    title: showcase.subtitles.recommendedActions,
    description: showcase.descriptions.recommendedActions,
    indicatorLabel: showcase.indicatorLabels.recommendedActions,
  },
  {
    title: showcase.subtitles.planOutcome,
    description: showcase.descriptions.planOutcome,
    indicatorLabel: showcase.indicatorLabels.planOutcome,
  },
];
---

<Section
  id="assistant"
  class="home-hero-section rounded-[var(--home-hero-radius)] border-t border-[var(--color-border)] bg-[var(--color-background)]"
>
  <Container class="flex flex-col items-center justify-center overflow-hidden">
    <h2 class="assistant-showcase-title" data-assistant-showcase-title>
      {showcase.title}
    </h2>

    <div class="hidden h-[390px] w-[190px] overflow-hidden lg:block max-[190px]:h-[calc(390px*var(--assistant-phone-scale))] max-[190px]:w-[calc(190px*var(--assistant-phone-scale))] max-[190px]:[--assistant-phone-scale:calc(100vw/190)]">
      <AssistantPhoneContent locale={locale} content={content} />
    </div>
  </Container>

  <div
    class="mx-auto w-full max-w-7xl lg:hidden"
    data-assistant-mobile-presentation
  >
    <h2
      class="m-0"
      data-assistant-mobile-heading
    >
      {showcase.title}
    </h2>

    <div
      class="relative"
      data-assistant-mobile-phone-stack
    >
      <div
        class="absolute inset-0 flex items-center justify-center"
        data-assistant-mobile-stage
        aria-hidden="false"
      >
        <div class="h-[390px] w-[190px] overflow-hidden">
          <AssistantPhoneContent locale={locale} content={content} />
        </div>
      </div>

      <div
        class="absolute inset-0 flex items-center justify-center"
        data-assistant-mobile-stage
        aria-hidden="true"
      >
        <div class="h-[390px] w-[190px] overflow-hidden">
          <AssistantPlanDeviationPhone
            locale={locale}
            content={planDeviationContent as any}
          />
        </div>
      </div>

      <div
        class="absolute inset-0 flex items-center justify-center"
        data-assistant-mobile-stage
        aria-hidden="true"
      >
        <div class="h-[390px] w-[190px] overflow-hidden">
          <AssistantRecommendedActionsPhone
            locale={locale}
            content={recommendedActionsContent as any}
          />
        </div>
      </div>

      <div
        class="absolute inset-0 flex items-center justify-center"
        data-assistant-mobile-stage
        aria-hidden="true"
      >
        <div class="h-[390px] w-[190px] overflow-hidden">
          <AssistantPlanOutcomePhone
            locale={locale}
            content={planOutcomeContent as any}
          />
        </div>
      </div>
    </div>

    <div
      class="w-full max-w-[32rem] text-center"
      data-assistant-mobile-copy
    >
      <h3
        id="assistant-mobile-stage-title"
        class="m-0"
        data-assistant-mobile-title
      >
        {mobileStageCopy[0].title}
      </h3>

      <p
        id="assistant-mobile-stage-description"
        class="m-0"
        data-assistant-mobile-description
      >
        {mobileStageCopy[0].description}
      </p>

      <div
        class="flex items-center gap-[10px]"
        data-assistant-mobile-indicators
        role="group"
        aria-label={showcase.indicatorGroupLabel}
      >
        {mobileStageCopy.map((stage, index) => (
          <button
            type="button"
            class="h-[6px] w-[38px] rounded-full border-0 bg-[color:color-mix(in_srgb,var(--color-text)_28%,transparent)]"
            data-assistant-mobile-indicator={index + 1}
            aria-label={stage.indicatorLabel}
            aria-current={index === 0 ? "step" : undefined}
          />
        ))}
      </div>
    </div>
  </div>
</Section>
