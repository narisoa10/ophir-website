---
import type { Locale } from "../../i18n/config";

type TextParams<T extends Record<string, string>> = (params: T) => string;

interface AssistantMockupContent {
  backLabel: string;
  infoLabel: string;
  chartLabel: string;
  step: string;
  title: string;
  todayLabel: TextParams<{ date: string }>;
  periodLabel: TextParams<{ currentDay: string; totalDays: string }>;
  incomeTitle: string;
  expenseTitle: string;
  planLabel: string;
  actualLabel: string;
  planToDateLabel: string;
  expensePlanProgressTitle: string;
  monthlyPlanLabel: string;
  monthEndForecastTitle: string;
  expensePlanLabel: string;
  expenseForecastLabel: string;
  projectedShortfallLabel: string;
  unchangedCaption: string;
  alertTitle: string;
  alertDescription: TextParams<{ shortfall: string }>;
}

interface Props {
  locale: Locale;
  content: AssistantMockupContent;
}

interface AssistantMockupData {
  date: Date;
  currentPeriodDay: number;
  totalPeriodDays: number;
  currencyCode: string;
  incomePlan: number;
  incomeActual: number;
  expensePlannedToDate: number;
  expenseActual: number;
  expensePlanCompletion: number;
  monthlyExpensePlan: number;
  expenseForecast: number;
  projectedShortfall: number;
}

const { locale, content } = Astro.props;

const mockupData: AssistantMockupData = {
  date: new Date(Date.UTC(2026, 6, 10)),
  currentPeriodDay: 10,
  totalPeriodDays: 30,
  currencyCode: "CAD",
  incomePlan: 4000,
  incomeActual: 4000,
  expensePlannedToDate: 1350,
  expenseActual: 2180,
  expensePlanCompletion: 0.81,
  monthlyExpensePlan: 4000,
  expenseForecast: 4940,
  projectedShortfall: 940,
};

const dateFormatter = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  timeZone: "UTC",
});

const numberFormatter = new Intl.NumberFormat(locale, {
  maximumFractionDigits: 0,
});

const moneyFormatter = new Intl.NumberFormat(locale, {
  style: "currency",
  currency: mockupData.currencyCode,
  currencyDisplay: "code",
  maximumFractionDigits: 0,
  minimumFractionDigits: 0,
});

const formatMoney = (value: number) => moneyFormatter.format(value);

const formattedDate = dateFormatter.format(mockupData.date);
const currentDay = numberFormatter.format(mockupData.currentPeriodDay);
const totalDays = numberFormatter.format(mockupData.totalPeriodDays);

const projectedShortfall = formatMoney(-mockupData.projectedShortfall);
---

<figure
  class="relative h-[390px] max-h-[390px] min-h-0 w-[190px] min-w-0 max-w-[190px] shrink-0 rounded-[25px] bg-[#10131b] p-1 shadow-[0_14px_30px_rgba(15,23,42,0.22)] max-[190px]:origin-top-left max-[190px]:[transform:scale(var(--assistant-phone-scale))]"
  aria-label={content.title}
>
  <div
    class="pointer-events-none absolute left-1/2 top-[9px] z-10 h-[3px] w-[33px] -translate-x-1/2 rounded-full bg-[#171b24]"
    aria-hidden="true"
  >
  </div>

  <div class="h-full w-full overflow-hidden rounded-[21px] bg-white">
    <div class="flex h-full flex-col px-2 pb-2 pt-1.5 text-[#152033]">
      <header class="flex h-5 shrink-0 items-center gap-1.5">
        <button
          type="button"
          class="flex size-4 items-center justify-center rounded-full text-[#172033]"
          aria-label={content.backLabel}
        >
          <svg
            class="size-[10px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>

        <span class="flex size-[17px] items-center justify-center rounded-full bg-[#10235f] text-[7px] font-semibold leading-none text-white">
          {content.step}
        </span>

        <h2 class="min-w-0 flex-1 text-[8px] font-semibold leading-none [letter-spacing:0] text-[#152033]">
          {content.title}
        </h2>

        <button
          type="button"
          class="flex size-4 items-center justify-center rounded-full border border-[#cfd6e3] text-[#5e6878]"
          aria-label={content.infoLabel}
        >
          <svg
            class="size-[8px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 10v6"></path>
            <path d="M12 7h.01"></path>
          </svg>
        </button>
      </header>

      <div class="mt-1.5 flex items-center justify-between gap-2 text-[6px] font-medium leading-none text-[#5d697c]">
        <p>{content.todayLabel({ date: formattedDate })}</p>
        <p>
          {
            content.periodLabel({
              currentDay,
              totalDays,
            })
          }
        </p>
      </div>

      <div class="mt-2 grid grid-cols-2 gap-1.5">
        <article class="rounded-[9px] border border-[#edf0f5] bg-white p-1.5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
          <h3 class="text-[7px] font-semibold leading-none text-[#263143]">
            {content.incomeTitle}
          </h3>

          <p class="mt-1.5 text-[14px] font-bold leading-none text-[#18a957]">
            {formatMoney(mockupData.incomeActual)}
          </p>

          <dl class="mt-2 grid gap-1 text-[6px] leading-none">
            <div class="flex items-center justify-between gap-1.5">
              <dt class="text-[#4d586b]">{content.planLabel}</dt>
              <dd class="font-semibold text-[#344154]">
                {formatMoney(mockupData.incomePlan)}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-1.5">
              <dt class="text-[#4d586b]">{content.actualLabel}</dt>
              <dd class="font-semibold text-[#344154]">
                {formatMoney(mockupData.incomeActual)}
              </dd>
            </div>
          </dl>

          <div
            class="mt-1.5 h-1 overflow-hidden rounded-full bg-[#eef1f6]"
            aria-hidden="true"
          >
            <span class="block h-full w-full rounded-full bg-[#12b15a]"></span>
          </div>
        </article>

        <article class="rounded-[9px] border border-[#edf0f5] bg-white p-1.5 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
          <h3 class="text-[7px] font-semibold leading-none text-[#263143]">
            {content.expenseTitle}
          </h3>

          <p class="mt-1.5 text-[14px] font-bold leading-none text-[#d62f45]">
            {formatMoney(mockupData.expenseActual)}
          </p>

          <dl class="mt-2 grid gap-1 text-[6px] leading-none">
            <div class="flex items-center justify-between gap-1.5">
              <dt class="max-w-[2.6rem] text-[#4d586b]">
                {content.planToDateLabel}
              </dt>
              <dd class="font-semibold text-[#344154]">
                {formatMoney(mockupData.expensePlannedToDate)}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-1.5">
              <dt class="text-[#4d586b]">{content.actualLabel}</dt>
              <dd class="font-semibold text-[#344154]">
                {formatMoney(mockupData.expenseActual)}
              </dd>
            </div>
          </dl>

          <div
            class="mt-1.5 h-1 overflow-hidden rounded-full bg-[#eef1f6]"
            aria-hidden="true"
          >
            <span class="block h-full w-full rounded-full bg-[#df3144]"></span>
          </div>
        </article>
      </div>

      <article class="mt-1.5 rounded-[9px] border border-[#edf0f5] bg-white p-2 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <h3 class="text-[7px] font-semibold leading-none text-[#263143]">
          {content.expensePlanProgressTitle}
        </h3>

        <div class="mt-2 rounded-[7px] bg-[#f9fafc] p-1.5">
          <div class="flex items-center justify-between gap-2 text-[6px] font-medium leading-none">
            <p class="text-[#4d586b]">{content.monthlyPlanLabel}</p>
            <p class="font-semibold text-[#344154]">
              {formatMoney(mockupData.monthlyExpensePlan)}
            </p>
          </div>

          <div class="mt-1.5 flex items-center justify-between gap-2 text-[6px] font-medium leading-none">
            <p class="text-[#4d586b]">{content.monthEndForecastTitle}</p>
            <p class="font-semibold text-[#344154]">
              {formatMoney(mockupData.expenseForecast)}
            </p>
          </div>

          <div class="mt-1.5 flex items-center justify-between gap-2 text-[6px] font-medium leading-none">
            <p class="text-[#4d586b]">{content.expensePlanLabel}</p>
            <p class="font-semibold text-[#344154]">
              {formatMoney(mockupData.expensePlannedToDate)}
            </p>
          </div>

          <div class="mt-1.5 flex items-center justify-between gap-2 text-[6px] font-medium leading-none">
            <p class="text-[#4d586b]">{content.expenseForecastLabel}</p>
            <p class="font-semibold text-[#344154]">
              {formatMoney(mockupData.expenseForecast)}
            </p>
          </div>
        </div>
      </article>

      <article class="mt-1.5 rounded-[9px] border border-[#edf0f5] bg-white p-2 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <div class="flex items-center justify-between gap-2 rounded-[7px] border border-[#edf0f5] bg-[#fbfcfe] px-1.5 py-1.5">
          <div class="flex min-w-0 flex-col gap-0.5">
            <h3 class="text-[7px] font-semibold leading-none text-[#263143]">
              {content.projectedShortfallLabel}
            </h3>
            <p class="text-[13px] font-bold leading-none text-[#d22c46]">
              {projectedShortfall}
            </p>
          </div>

          <div class="flex size-[22px] items-center justify-center rounded-full bg-[#fff0f2] text-[#e12d4b]">
            <svg
              class="size-[11px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 10v8"></path>
              <path d="M12 6v12"></path>
              <path d="M18 12v6"></path>
            </svg>
          </div>
        </div>

        <p class="mt-1.5 text-[6px] font-medium leading-none text-[#5d697c]">
          {content.unchangedCaption}
        </p>
      </article>

      <article class="mt-1.5 rounded-[9px] border border-[#edf0f5] bg-white p-2 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
        <div class="flex items-center justify-between gap-2">
          <div class="flex-1">
            <h3 class="text-[7px] font-semibold leading-none text-[#263143]">
              {content.alertTitle}
            </h3>
            <p class="mt-1 text-[6px] font-medium leading-none text-[#5d697c]">
              {content.alertDescription({ shortfall: projectedShortfall })}
            </p>
          </div>
          <div class="flex size-[22px] items-center justify-center rounded-full bg-[#fff1f4] text-[#d62f45]">
            <svg
              class="size-[11px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3 3 20h18L12 3Z"></path>
              <path d="M12 8v5"></path>
              <path d="M12 16h.01"></path>
            </svg>
          </div>
        </div>
      </article>
    </div>
  </div>
</figure>
