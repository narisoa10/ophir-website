---
import { footerNavigationGroups } from "../../config/footer-navigation";
import { siteConfig } from "../../config/site";
import {
  getLocalizedHomeSectionHref,
  getLocalizedInternalPageHref,
} from "../../config/site-routes";
import type { Locale } from "../../i18n/config";
import OphirLogo from "../brand/OphirLogo.astro";
import Container from "./Container.astro";

interface FooterContent {
  ariaLabel: string;
  brandLabel: string;
  description: string;
  contactLabel: string;
  emailLabel: string;
  addressLabel: string;
  groups: Record<(typeof footerNavigationGroups)[number]["key"], string>;
  links: Record<
    (typeof footerNavigationGroups)[number]["links"][number]["key"],
    string
  >;
  copyrightPrefix: string;
  copyrightSuffix: string;
  countryNote: string;
}

interface Props {
  locale: Locale;
  content: FooterContent;
}

const { locale, content } = Astro.props;
const currentYear = new Date().getFullYear();
const contactEmails = Object.values(siteConfig.contacts);
const address = siteConfig.address;

function getFooterHref(
  link: (typeof footerNavigationGroups)[number]["links"][number]
) {
  if (link.type === "homeSection") {
    return getLocalizedHomeSectionHref(locale, link.section);
  }

  return getLocalizedInternalPageHref(locale, link.page);
}
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a
          href={`/${locale}/`}
          class="site-footer__logo-link"
          aria-label={content.brandLabel}
        >
          <OphirLogo
            label={content.brandLabel}
            class="site-footer__logo"
          />
        </a>

        <p class="site-footer__description">
          {content.description}
        </p>

        <section class="site-footer__contact" aria-labelledby="site-footer-contact">
          <h2 id="site-footer-contact" class="site-footer__contact-label">
            {content.contactLabel}
          </h2>

          <div class="site-footer__contact-grid">
            <div class="site-footer__contact-group">
              <p class="site-footer__contact-subtitle">
                {content.emailLabel}
              </p>

              <ul class="site-footer__email-list">
                {
                  contactEmails.map((email) => (
                    <li>
                      <a
                        href={`mailto:${email}`}
                        class="site-footer__contact-link"
                      >
                        {email}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="site-footer__contact-group">
              <p class="site-footer__contact-subtitle">
                {content.addressLabel}
              </p>

              <address class="site-footer__address">
                <span>{address.street}</span>
                <span>
                  {address.city}, {address.region} {address.postalCode}
                </span>
                <span>{address.country}</span>
              </address>
            </div>
          </div>
        </section>
      </div>

      <nav
        class="site-footer__navigation"
        aria-label={content.ariaLabel}
      >
        {
          footerNavigationGroups.map((group) => (
            <section class="site-footer__group" aria-labelledby={`site-footer-${group.key}`}>
              <h2 id={`site-footer-${group.key}`} class="site-footer__group-title">
                {content.groups[group.key]}
              </h2>

              <ul class="site-footer__link-list">
                {group.links.map((link) => (
                  <li>
                    <a href={getFooterHref(link)} class="site-footer__link">
                      {content.links[link.key]}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        {content.copyrightPrefix} {currentYear} {siteConfig.name}.{" "}
        {content.copyrightSuffix}
      </p>

      <p class="site-footer__country">
        {content.countryNote}
      </p>
    </div>
  </Container>
</footer>
