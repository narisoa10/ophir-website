---
import {
  getInternalPageSlug,
  internalPageKeys,
  type InternalPageKey,
} from "../../config/site-routes";
import { locales, type Locale } from "../../i18n/config";
import InternalPage from "../../components/views/InternalPage.astro";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    internalPageKeys.map((pageKey) => ({
      params: {
        locale,
        slug: getInternalPageSlug(pageKey),
      },
      props: {
        locale,
        pageKey,
      },
    }))
  );
}

interface Props {
  locale: Locale;
  pageKey: InternalPageKey;
}

const { locale, pageKey } = Astro.props;
---

<InternalPage locale={locale} pageKey={pageKey} />
